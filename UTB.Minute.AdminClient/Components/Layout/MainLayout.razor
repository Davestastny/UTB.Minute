@inherits LayoutComponentBase

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        <nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block bg-light sidebar collapse shadow-sm" style="min-height: 100vh;">
            <div class="position-sticky pt-3">
                <h5 class="px-3 text-primary"><i class="bi bi-egg-fried"></i> Canteen Admin</h5>
                <ul class="nav flex-column mt-4">
                    <li class="nav-item">
                        <NavLink class="nav-link" href="dishes" Match="NavLinkMatch.Prefix">
                            <i class="bi bi-card-list me-2"></i> Dishes
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="menu" Match="NavLinkMatch.Prefix">
                            <i class="bi bi-calendar3 me-2"></i> Menu
                        </NavLink>
                    </li>
                </ul>
                <div class="px-3 mt-5">
                    <a href="/logout" class="btn btn-outline-danger btn-sm w-100">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </a>
                </div>
            </div>
        </nav>

        <!-- Main content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 mt-4">
            @Body
        </main>
    </div>
</div>

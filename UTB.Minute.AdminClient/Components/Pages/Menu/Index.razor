@page "/menu"
@inject IHttpClientFactory HttpClientFactory

<h3>Menu Items</h3>

<div class="mb-3 d-flex justify-content-between">
    <div>
        <a href="/menu/create" class="btn btn-primary">Create New Menu Item</a>
    </div>
    <div class="d-flex">
        <input type="date" class="form-control me-2" @bind="selectedDate" />
        <button class="btn btn-outline-secondary" @onclick="LoadMenuForDate">Filter by Date</button>
        <button class="btn btn-outline-secondary ms-2" @onclick="LoadAllMenu">Show All</button>
    </div>
</div>

@if (menuItems == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Date</th>
                <th>Dish</th>
                <th>Price</th>
                <th>Available Portions</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in menuItems.OrderBy(m => m.MenuDate))
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.MenuDate.ToShortDateString()</td>
                    <td>@item.DishName</td>
                    <td>@item.DishPrice.ToString("C")</td>
                    <td>@item.AvailablePortions</td>
                    <td>
                        <a href="/menu/edit/@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteMenuItem(item.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private MenuItemDto[]? menuItems;
    private DateTime selectedDate = DateTime.Today;
    private HttpClient _client = default!;

    protected override async Task OnInitializedAsync()
    {
        _client = HttpClientFactory.CreateClient("webapi");
        await LoadAllMenu();
    }

    private async Task LoadAllMenu()
    {
        menuItems = await _client.GetFromJsonAsync<MenuItemDto[]>("/menu-items");
    }

    private async Task LoadMenuForDate()
    {
        var dateString = selectedDate.ToString("yyyy-MM-dd");
        menuItems = await _client.GetFromJsonAsync<MenuItemDto[]>($"/menu-items/by-date/{dateString}");
    }

    private async Task DeleteMenuItem(int id)
    {
        await _client.DeleteAsync($"/menu-items/{id}");
        // Refresh current view based on whether we were filtered or not
        // A simple reload of all works for this demo
        await LoadAllMenu();
    }
}

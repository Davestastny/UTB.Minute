@inherits LayoutComponentBase

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        <nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block bg-light sidebar collapse shadow-sm" style="min-height: 100vh;">
            <div class="position-sticky pt-3">
                <h5 class="px-3 text-primary"><i class="bi bi-cup-hot"></i> UTB Minute</h5>
                <ul class="nav flex-column mt-4">
                    <AuthorizeView Roles="student">
                        <li class="nav-item">
                            <NavLink class="nav-link" href="student/menu" Match="NavLinkMatch.All">
                                <i class="bi bi-list-ul me-2"></i> Today's Menu
                            </NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="student/orders" Match="NavLinkMatch.All">
                                <i class="bi bi-clock-history me-2"></i> My Orders
                            </NavLink>
                        </li>
                    </AuthorizeView>
                    
                    <AuthorizeView Roles="cook,admin">
                        <li class="nav-item">
                            <NavLink class="nav-link" href="cook/orders" Match="NavLinkMatch.All">
                                <i class="bi bi-fire me-2"></i> Kitchen Orders
                            </NavLink>
                        </li>
                    </AuthorizeView>
                </ul>
                <div class="px-3 mt-5">
                    <AuthorizeView>
                        <Authorized>
                            <div class="mb-3 text-muted small text-truncate">
                                Logged in as: <strong>@context.User.Identity?.Name</strong>
                            </div>
                            <a href="/logout" class="btn btn-outline-danger btn-sm w-100">
                                <i class="bi bi-box-arrow-right"></i> Logout
                            </a>
                        </Authorized>
                        <NotAuthorized>
                            <a href="cook/orders" class="btn btn-primary btn-sm w-100">
                                <i class="bi bi-box-arrow-in-right"></i> Staff Login
                            </a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>
        </nav>

        <!-- Main content -->
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 mt-4">
            @Body
        </main>
    </div>
</div>